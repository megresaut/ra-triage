# RA Triage — root-level environment variables.
#
# This file is sourced by:
#   1. The backend (via pydantic-settings) at
#      `backend/src/ra_triage/settings.py`, which points its env_file at this
#      location (`~/code/ra-triage/.env`).
#   2. The `./dev.sh` overmind launcher, which exports these into both the
#      backend and frontend processes.
#
# Copy to `.env`, fill in real values, and never commit `.env`.
#
# Placeholders only below. Do not commit real secrets here.

# --- Notion ---
# Notion SDK's default env var name. Megha already exports this at the shell
# level, so you may choose to leave it blank here and rely on the shell
# environment instead — pydantic-settings reads both.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion database ID for the (currently only) bug tracker, which is RA AVM's.
# Shared across all projects in v1 — if Triage ever supports a second bug DB,
# this becomes per-project in the registry.
NOTION_BUGS_DB_ID=00000000000000000000000000000000

# --- Slack ---
# Incoming webhook URL for the RA AVM channel that receives escalation and
# ready-for-review pings.
RA_AVM_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- GitHub (optional) ---
# The `gh` CLI is typically already authenticated on Megha's machine; this is
# only needed if that auth is missing. Uncomment and fill if so.
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Triage process config ---
# Local filesystem root for the triage SQLite DB, worktrees, logs, snapshots,
# prompts. Created by `make db-init`.
TRIAGE_HOME=~/ra-triage

# Port this tool's own backend binds on (127.0.0.1 only).
TRIAGE_BACKEND_PORT=5000

# Allowed frontend origin for CORS. Must match the Vite dev server exactly.
TRIAGE_FRONTEND_ORIGIN=http://127.0.0.1:1313
